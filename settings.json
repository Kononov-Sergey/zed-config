// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "colorize_brackets": true,
  "git": {
    "inline_blame": {
      "location": "status_bar",
    },
  },
  "agent": {
    "favorite_models": [],
    "model_parameters": [],
    "thinking_display": "always_collapsed",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato",
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_fallbacks": ["monospace"],
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "always",
  },
  "autosave": "on_window_change",
  "format_on_save": "on",
  "agent_servers": {
    "cursor": {
      "favorite_config_option_values": {
        "model": ["composer-2.5", "grok-4.7"],
        "reasoning_effort": ["xhigh", "medium"],
        "context": ["500k"],
      },
      "default_config_options": {
        "context": "500k",
        "reasoning_effort": "medium",
        "model": "composer-2.5",
      },
      "type": "registry",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCode Dark Modern",
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "css-modules-kit": true,
    "dockerfile": true,
    "ejs": true,
    "env": true,
    "git-firefly": true,
    "html": true,
    "one-dark-pro": true,
    "scss": true,
    "svelte": true,
    "vscode-dark-modern": true
  },
  "markdown_preview": {
    "open_markdown_files_in_preview": true,
  },
}
